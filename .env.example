# ZeroWaste Grocer Environment Configuration

# Backend API Settings
API_V1_STR=/api/v1
PROJECT_NAME="ZeroWaste Grocer API"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database & Environment
# Options: zerowaste_real.db (realistic baseline) | zerowaste.db
DB_NAME=zerowaste_real.db

# Server Bind Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Client Configuration
ZEROWASTE_API_BASE_URL=http://127.0.0.1:8000/api/v1
